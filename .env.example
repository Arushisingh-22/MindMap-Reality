# ==============================================================================
# MINDMAP REALITY: ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================
# Instructions:
# 1. Duplicate this file and rename it to `.env` in the project root:
#    cp .env.example .env
# 2. Log in to your Supabase Dashboard: https://supabase.com/dashboard
# 3. Open your project -> Navigate to Project Settings -> API
# 4. Copy the Project URL and anon / public API key into the variables below.
#
# IMPORTANT SECURITY NOTICE:
# - Use ONLY the `anon` / `public` API key here.
# - NEVER put your `service_role` (secret) key in frontend environment variables!
# ==============================================================================

# Your Supabase project URL (format: https://<project-ref>.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase public anonymous API key (starts with "eyJ...")
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
